# Website server settings. Never use NEXT_PUBLIC_ for secrets.
WEBSITE_URL=https://delta-bot.online
DISCORD_CLIENT_ID=your-discord-application-id
DISCORD_CLIENT_SECRET=
# Discord server containing the beta tester role (required for maintenance bypass).
BETA_TESTER_GUILD_ID=
BETA_TESTER_ROLE_ID=1575157161175285832
# Legacy trial redirect (not needed for shared OAuth login):
# DISCORD_TRIAL_REDIRECT_URI=https://delta-bot.online/api/trial/callback
# Use a separate random secret of at least 32 characters for each signing key.
TRIAL_SESSION_SECRET=

# Central OAuth: register https://delta-bot.online/api/dashboard/callback
# in Discord Developer Portal > OAuth2 > Redirects.
# Landing login, server dashboard, user dashboard, admin and trial now share
# this callback. Server dashboard path: /server-dashboard.
# Also retain legacy callbacks only while migrating existing integrations.
DISCORD_DASHBOARD_REDIRECT_URI=https://delta-bot.online/api/dashboard/callback

# Shared MongoDB connection for website storage and dashboard. Use the same URI
# AND MONGODB_DB_NAME on the bot for per-server configuration sync.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=deltaweb
# Dedicated trial database; must match the bot.
TRIAL_MONGODB_DB=delta_trials

TRUSTED_CLIENT_IP_HEADER=
# Optional HTTPS ip-api Pro geolocation when platform location is unavailable.
IP_API_PRO_KEY=

# Admin settings.
ADMIN_ALLOWED_DISCORD_USER_IDS=your-admin-discord-user-id
ADMIN_SESSION_SECRET=
# Legacy admin callback (not needed for shared OAuth login):
# DISCORD_REDIRECT_URI=https://delta-bot.online/api/auth/discord/callback
