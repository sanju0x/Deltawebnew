# Website server settings. Never use NEXT_PUBLIC_ for secrets.
WEBSITE_URL=https://yourwebsite.com
DISCORD_CLIENT_ID=your-discord-application-id
DISCORD_CLIENT_SECRET=
DISCORD_TRIAL_REDIRECT_URI=https://yourwebsite.com/api/trial/callback
# Use a separate random secret of at least 32 characters for each signing key.
TRIAL_SESSION_SECRET=

# Register BOTH callback URLs in Discord Developer Portal > OAuth2 > Redirects:
# https://dash.delta-bot.online/api/dashboard/callback (server dashboard)
# https://delta-bot.online/api/dashboard/callback (existing user dashboard)
# The server dashboard callback is selected automatically based on the request host.
# Keep this setting for the user dashboard login on the main website.
DISCORD_DASHBOARD_REDIRECT_URI=https://delta-bot.online/api/dashboard/callback

# Shared MongoDB connection for website storage and dashboard. Use the same URI
# AND MONGODB_DB_NAME on the bot for per-server configuration sync.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=deltaweb
# Dedicated trial database; must match the bot.
TRIAL_MONGODB_DB=delta_trials

# For self-hosted visitor tracking and per-client limits, name a single-IP
# header overwritten by your trusted reverse proxy. Vercel is auto-detected.
TRUSTED_CLIENT_IP_HEADER=
# Optional HTTPS ip-api Pro geolocation when platform location is unavailable.
IP_API_PRO_KEY=

# Admin settings.
ADMIN_ALLOWED_DISCORD_USER_IDS=your-admin-discord-user-id
ADMIN_SESSION_SECRET=
DISCORD_REDIRECT_URI=https://yourwebsite.com/api/auth/discord/callback
